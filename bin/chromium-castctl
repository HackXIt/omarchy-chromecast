#!/usr/bin/env node
'use strict';

const castctl = require('../lib/chromium-castctl');

if (require.main === module) {
  castctl.run().then((code) => {
    process.exitCode = code;
  }).catch((error) => {
    process.stderr.write(`${error.message || String(error)}\n`);
    process.exitCode = 1;
  });
}

module.exports = castctl;
