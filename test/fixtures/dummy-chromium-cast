#!/usr/bin/env node
'use strict';

const crypto = require('node:crypto');
const http = require('node:http');

const sinkName = process.env.CHROMIUM_CASTCTL_DUMMY_SINK_NAME || 'Dummy Chromecast';
let port = Number.parseInt(argValue('--remote-debugging-port=') || '', 10);
const address = argValue('--remote-debugging-address=') || '127.0.0.1';
const userDataDir = argValue('--user-data-dir=');
const hostileWebSocketUrl = process.env.CHROMIUM_CASTCTL_DUMMY_HOSTILE_WS_URL || '';
const failStop = process.env.CHROMIUM_CASTCTL_DUMMY_FAIL_STOP === '1';
const malformedJson = process.env.CHROMIUM_CASTCTL_DUMMY_MALFORMED_JSON === '1';
const oversizedWsBytes = Number.parseInt(process.env.CHROMIUM_CASTCTL_DUMMY_OVERSIZED_WS_BYTES || '', 10);
const floodCount = Number.parseInt(process.env.CHROMIUM_CASTCTL_DUMMY_FLOOD_SINKS || '', 10);
const devToolsDelayMs = Number.parseInt(process.env.CHROMIUM_CASTCTL_DUMMY_DEVTOOLS_DELAY_MS || '', 10);
const cdpReadyDelayMs = Number.parseInt(process.env.CHROMIUM_CASTCTL_DUMMY_CDP_READY_DELAY_MS || '', 10);
const startedAt = Date.now();
let active = false;

if (process.env.CHROMIUM_CASTCTL_DUMMY_FLATTEN_CMDLINE === '1') {
  const [executable, script, ...args] = process.argv;
  const switches = args.filter((arg) => arg.startsWith('--'));
  const positionals = args.filter((arg) => !arg.startsWith('--'));
  process.title = [executable, script, ...switches, ...positionals].join(' ');
}

if (!Number.isInteger(port) || port < 0) {
  process.stderr.write('dummy-chromium-cast: missing --remote-debugging-port\n');
  process.exit(2);
}

function dummySinkNames() {
  if (!process.env.CHROMIUM_CASTCTL_DUMMY_SINKS_JSON) return [sinkName];
  try {
    const parsed = JSON.parse(process.env.CHROMIUM_CASTCTL_DUMMY_SINKS_JSON);
    return Array.isArray(parsed) && parsed.length > 0 ? parsed.map(String) : [sinkName];
  } catch {
    return [sinkName];
  }
}

function argValue(prefix) {
  const arg = process.argv.slice(2).find((value) => value.startsWith(prefix));
  return arg ? arg.slice(prefix.length) : null;
}

function pageTarget() {
  return {
    id: 'dummy-page',
    type: 'page',
    title: 'Dummy Chromecast Target',
    url: 'about:blank',
    webSocketDebuggerUrl: hostileWebSocketUrl || `ws://${address}:${port}/devtools/page/dummy-page`,
  };
}

function writeJson(response, value) {
  const body = `${JSON.stringify(value)}\n`;
  response.writeHead(200, {
    'content-type': 'application/json',
    'content-length': Buffer.byteLength(body),
  });
  response.end(body);
}

function sinks() {
  return dummySinkNames().map((name, index) => ({
    name,
    session: active ? { id: `dummy-session-${index}` } : null,
  }));
}

function sendFrame(socket, message) {
  const payload = Buffer.from(JSON.stringify(message), 'utf8');
  let header;
  if (payload.length < 126) {
    header = Buffer.from([0x81, payload.length]);
  } else if (payload.length < 65536) {
    header = Buffer.alloc(4);
    header[0] = 0x81;
    header[1] = 126;
    header.writeUInt16BE(payload.length, 2);
  } else {
    header = Buffer.alloc(10);
    header[0] = 0x81;
    header[1] = 127;
    header.writeBigUInt64BE(BigInt(payload.length), 2);
  }
  socket.write(Buffer.concat([header, payload]));
}

function parseFrame(buffer) {
  if (buffer.length < 2) return null;
  const first = buffer[0];
  const second = buffer[1];
  const opcode = first & 0x0f;
  const masked = Boolean(second & 0x80);
  let length = second & 0x7f;
  let offset = 2;

  if (length === 126) {
    if (buffer.length < offset + 2) return null;
    length = buffer.readUInt16BE(offset);
    offset += 2;
  } else if (length === 127) {
    if (buffer.length < offset + 8) return null;
    const bigLength = buffer.readBigUInt64BE(offset);
    if (bigLength > BigInt(Number.MAX_SAFE_INTEGER)) throw new Error('WebSocket frame too large');
    length = Number(bigLength);
    offset += 8;
  }

  let mask;
  if (masked) {
    if (buffer.length < offset + 4) return null;
    mask = buffer.subarray(offset, offset + 4);
    offset += 4;
  }

  if (buffer.length < offset + length) return null;
  const payload = Buffer.from(buffer.subarray(offset, offset + length));
  if (masked) {
    for (let index = 0; index < payload.length; index += 1) {
      payload[index] ^= mask[index % 4];
    }
  }

  return {
    opcode,
    text: payload.toString('utf8'),
    rest: buffer.subarray(offset + length),
  };
}

function handleCdpMessage(socket, raw) {
  const message = JSON.parse(raw);
  const id = message.id;
  const method = message.method;

  if (method === 'Browser.getWindowForTarget') {
    sendFrame(socket, { id, result: { windowId: 1 } });
  } else if (method === 'Browser.setWindowBounds') {
    sendFrame(socket, { id, result: {} });
  } else if (method === 'Cast.enable') {
    if (malformedJson) {
      socket.write(Buffer.from([0x81, 0x05, 0x7b, 0x6e, 0x6f, 0x70, 0x65]));
      return;
    }
    if (Number.isInteger(oversizedWsBytes) && oversizedWsBytes > 0) {
      sendFrame(socket, { id, result: 'x'.repeat(oversizedWsBytes) });
      return;
    }
    sendFrame(socket, { id, result: {} });
    const repeats = Number.isInteger(floodCount) && floodCount > 0 ? floodCount : 1;
    for (let index = 0; index < repeats; index += 1) {
      sendFrame(socket, { method: 'Cast.sinksUpdated', params: { sinks: sinks() } });
    }
  } else if (method === 'Cast.startDesktopMirroring') {
    active = true;
    sendFrame(socket, { id, result: {} });
    sendFrame(socket, { method: 'Cast.sinksUpdated', params: { sinks: sinks() } });
  } else if (method === 'Cast.stopCasting') {
    if (failStop) {
      sendFrame(socket, { id, error: { message: 'dummy stop failure' } });
      return;
    }
    active = false;
    sendFrame(socket, { id, result: {} });
    sendFrame(socket, { method: 'Cast.sinksUpdated', params: { sinks: sinks() } });
  } else if (method === 'Browser.close') {
    sendFrame(socket, { id, result: {} });
    setTimeout(() => process.exit(0), 20);
  } else {
    sendFrame(socket, { id, result: {} });
  }
}

const server = http.createServer((request, response) => {
  const url = new URL(request.url, `http://${address}:${port}`);
  if (Number.isFinite(cdpReadyDelayMs) && cdpReadyDelayMs > Date.now() - startedAt) {
    response.writeHead(503, { 'content-type': 'text/plain' });
    response.end('not ready\n');
    return;
  }
  if (url.pathname === '/json/list') {
    writeJson(response, [pageTarget()]);
  } else if (url.pathname === '/json/new') {
    writeJson(response, pageTarget());
  } else {
    response.writeHead(404, { 'content-type': 'text/plain' });
    response.end('not found\n');
  }
});

server.on('upgrade', (request, socket) => {
  const key = request.headers['sec-websocket-key'];
  if (!key) {
    socket.destroy();
    return;
  }

  const accept = crypto
    .createHash('sha1')
    .update(`${key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11`)
    .digest('base64');

  socket.write([
    'HTTP/1.1 101 Switching Protocols',
    'Upgrade: websocket',
    'Connection: Upgrade',
    `Sec-WebSocket-Accept: ${accept}`,
    '',
    '',
  ].join('\r\n'));

  let buffer = Buffer.alloc(0);
  socket.on('data', (chunk) => {
    buffer = Buffer.concat([buffer, chunk]);
    while (buffer.length > 0) {
      const frame = parseFrame(buffer);
      if (!frame) return;
      buffer = frame.rest;
      if (frame.opcode === 0x8) {
        socket.end();
        return;
      }
      if (frame.opcode === 0x1) handleCdpMessage(socket, frame.text);
    }
  });
});

server.listen(port, address, () => {
  port = server.address().port;
  if (userDataDir) {
    setTimeout(() => {
      const fs = require('node:fs');
      fs.mkdirSync(userDataDir, { recursive: true });
      fs.writeFileSync(`${userDataDir}/DevToolsActivePort`, `${port}\n/devtools/browser/dummy\n`, 'utf8');
    }, Number.isFinite(devToolsDelayMs) && devToolsDelayMs > 0 ? devToolsDelayMs : 0);
  }
});

process.on('SIGTERM', () => process.exit(0));
process.on('SIGINT', () => process.exit(0));
